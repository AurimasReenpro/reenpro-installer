VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Legacy alias for the publishable/anon key. The app reads PUBLISHABLE_KEY first
# and falls back to this, so set EITHER one (only needed if your Supabase project
# still issues the old "anon" key name).
VITE_SUPABASE_ANON_KEY=

# Sentry error monitoring (OPTIONAL).
# Leave empty for local dev — the app detects the empty value and simply skips
# Sentry init (see src/lib/sentry.ts), so nothing crashes. For production, paste
# your project DSN from Sentry → Settings → Projects → Client Keys (DSN).
VITE_SENTRY_DSN=

# Map – company warehouse / base coordinates (default: Kaunas center)
VITE_BASE_LAT=54.8985
VITE_BASE_LNG=23.9036
VITE_BASE_LABEL=Įmonės sandėlis
